{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[0-9]{5}$/)",
        ".write": "auth != null && $code.matches(/^[0-9]{5}$/) && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('host').val() === auth.uid))",
        ".validate": "newData.hasChildren(['host', 'createdAt', 'mode', 'song', 'difficulty', 'round', 'phase', 'startAt'])",
        "host": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "mode": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().matches(/^(versus|coop)$/)"
        },
        "song": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 64 && newData.val().matches(/^[a-z0-9-]*$/)"
        },
        "difficulty": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().matches(/^(easy|normal|hard|extreme)$/)"
        },
        "round": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000"
        },
        "phase": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().matches(/^(lobby|loading|playing|result)$/)"
        },
        "startAt": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "seats": {
          "$seat": {
            ".write": "auth != null && ((newData.exists() && newData.child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid) && ($seat === 'p2' || root.child('rooms').child($code).child('host').val() === auth.uid)) || (!newData.exists() && data.child('uid').val() === auth.uid))",
            ".validate": "($seat === 'p1' || $seat === 'p2') && newData.hasChildren(['uid', 'name', 'difficulty', 'ready', 'loaded', 'finished', 'score', 'combo', 'maxCombo', 'gauge', 'counts', 'last', 'stamp', 'stampAt'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            },
            "difficulty": {
              ".validate": "newData.isString() && newData.val().matches(/^(easy|normal|hard|extreme)$/)"
            },
            "ready": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "loaded": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "finished": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
            },
            "combo": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "maxCombo": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "gauge": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "counts": {
              ".validate": "newData.hasChildren(['great', 'good', 'ok', 'miss'])",
              "great": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
              },
              "good": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
              },
              "ok": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
              },
              "miss": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
              },
              "$other": {
                ".validate": false
              }
            },
            "last": {
              ".validate": "newData.isString() && newData.val().matches(/^(great|good|ok|miss)?$/)"
            },
            "stamp": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "stampAt": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "mk": {
              "$chunk": {
                ".validate": "$chunk.matches(/^c[0-9]{1,3}$/) && newData.isString() && newData.val().length <= 100 && newData.val().matches(/^[Ggom.]*$/)"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
